import React, {
    useEffect,
    useState,
} from "react";


import {
    useSelector,
} from "react-redux";


import {
    ToolBar,
    Icon,
} from "../../../utils/general";


import "./assets/docker.scss";



const Docker = () => {



const wnapp =
useSelector(
state =>
state.apps.docker
);



const [
containers,
setContainers
]=useState([]);



const [
tab,
setTab
]=useState(
"Containers"
);



const [
create,
setCreate
]=useState(false);



const [
image,
setImage
]=useState("");



const [
name,
setName
]=useState("");



const [
ports,
setPorts
]=useState([
{
host:"",
container:""
}
]);



const [
env,
setEnv
]=useState([
""
]);



const [
command,
setCommand
]=useState("");



const [
tty,
setTTY
]=useState(false);



const [
privileged,
setPrivileged
]=useState(false);



const [
devices,
setDevices
]=useState([
""
]);





/*
==============================
加载容器
==============================
*/


const loadContainers =
async()=>{


try{


const res =
await fetch(
"/api/docker/containers",
{
credentials:"include"
}
);



const data =
await res.json();



setContainers(
data
);



}catch(e){

console.error(e);

}


};





useEffect(()=>{


loadContainers();


},[]);





/*
==============================
Docker操作
==============================
*/


const action =
async(
url
)=>{


await fetch(
url,
{
method:"POST",
credentials:"include"
}
);



loadContainers();


};






const remove =
async(
id
)=>{


await fetch(
`/api/docker/container/${id}`,
{
method:"DELETE",
credentials:"include"
}
);



loadContainers();


};






/*
==============================
创建容器
==============================
*/


const createContainer =
async()=>{


if(!image)
return;



await fetch(
"/api/docker/container/create",
{


method:"POST",


headers:{

"Content-Type":
"application/json"

},


credentials:"include",


body:JSON.stringify({

image:image,

name:name,


ports:
ports.filter(
p=>
p.host &&
p.container
),


env:
env.filter(
e=>e
),


command:command,


tty:tty,


privileged:privileged,


devices:
devices.filter(
d=>d
)


})


}

);





setImage("");

setName("");

setPorts([
{
host:"",
container:""
}
]);

setEnv([
""
]);

setCommand("");

setTTY(false);

setPrivileged(false);

setDevices([
""
]);



setCreate(false);


loadContainers();


};





/*
==============================
Terminal
==============================
*/


const terminal =
(id)=>{


window.open(
`/terminal/docker/${id}`
);


};





const tabs=[


{
title:"Containers",
icon:"faBoxes"
},


{
title:"Images",
icon:"faLayerGroup"
},


{
title:"Volumes",
icon:"faHardDrive"
},


{
title:"Networks",
icon:"faNetworkWired"
}


];



return (

<div

className="dockerApp floatTab dpShad"

data-size={
wnapp.size
}

data-max={
wnapp.max
}

style={{

...(wnapp.size==="cstm"
?
wnapp.dim
:
null
),

zIndex:
wnapp.z

}}

data-hide={
wnapp.hide
}

id={
wnapp.icon+"App"
}

>


<ToolBar

app={
wnapp.action
}

icon={
wnapp.icon
}

size={
wnapp.size
}

name="Docker Manager"

/>



<div
className="windowScreen flex flex-col"
>


<div
className="restWindow flex flex-grow"
>



<nav>


{
tabs.map(
(item,index)=>(


<div

key={index}

className={
tab===item.title
?
"navLink selected"
:
"navLink"
}

onClick={()=>
setTab(
item.title
)
}

>


<Icon

fafa={
item.icon
}

/>


<span>
{item.title}
</span>


</div>


)

)

}


</nav>



<main
className="win11Scroll"
>


<div className="docker-title">


<h3>
{tab}
</h3>


{

tab==="Containers" &&


<button

className="add-container"

onClick={()=>
setCreate(true)
}

>

+

</button>


}


</div>





{
tab==="Containers" &&


<div

className="docker-list"

>


{
containers.map(
container=>(


<div

className="docker-card"

key={
container.id
}

>


<div className="docker-header">


<Icon

fafa="faDocker"

/>


<strong>
{
container.name
}
</strong>


</div>



<div>

Image:

{
container.image
}

</div>



<div>

Status:

<span

className={
container.state==="running"
?
"running"
:
"stopped"
}

>

{
container.status
}

</span>


</div>



<div className="docker-actions">


<button

onClick={()=>
terminal(
container.id
)
}

>

Terminal

</button>


<button

onClick={()=>
action(
`/api/docker/container/stop/${container.id}`
)
}

>

Stop

</button>



<button

onClick={()=>
action(
`/api/docker/container/restart/${container.id}`
)
}

>

Restart

</button>



<button

onClick={()=>
remove(
container.id
)
}

>

Remove

</button>



</div>



</div>


)

)

}


</div>


}






{
tab!=="Containers" &&


<div className="empty-tab">

{tab}

</div>


}





</main>



</div>


{
create &&

<div className="docker-dialog">

<div className="dialog-box">


<h2>
Create Container
</h2>



<label>
Image
</label>

<input

placeholder="nginx:latest"

value={image}

onChange={
e=>
setImage(
e.target.value
)
}

/>



<label>
Name
</label>


<input

placeholder="my-container"

value={name}

onChange={
e=>
setName(
e.target.value
)
}

/>



<h3>
Port Mapping
</h3>


{

ports.map(
(port,index)=>(

<div
className="config-row"
key={index}
>


<input

placeholder="Host Port"

value={
port.host
}

onChange={
e=>{

let p=[
...ports
];

p[index].host=
e.target.value;

setPorts(p);

}

}

/>


<span>
:
</span>


<input

placeholder="Container Port"

value={
port.container
}

onChange={
e=>{

let p=[
...ports
];

p[index].container=
e.target.value;

setPorts(p);

}

}

/>


<button

onClick={()=>{


setPorts(
ports.filter(
(_,i)=>
i!==index
)
);


}}

>

-

</button>


</div>


)

)

}



<button

className="small-btn"

onClick={()=>


setPorts(
[
...ports,
{
host:"",
container:""
}
]

)


}

>

+ Port

</button>







<h3>
Environment
</h3>


{

env.map(
(item,index)=>(


<div
className="config-row"
key={index}
>


<input

placeholder="KEY=value"

value={item}

onChange={
e=>{

let v=[
...env
];

v[index]=
e.target.value;

setEnv(v);


}

}

/>



<button

onClick={()=>{


setEnv(
env.filter(
(_,i)=>
i!==index
)
);


}}

>

-

</button>


</div>


)

)

}




<button

className="small-btn"

onClick={()=>


setEnv(
[
...env,
""
]
)


}

>

+ ENV

</button>







<h3>
Execute Command
</h3>


<input

placeholder="/bin/bash"

value={command}

onChange={
e=>
setCommand(
e.target.value
)
}

/>








<h3>
Options
</h3>



<label
className="checkbox"
>


<input

type="checkbox"

checked={tty}

onChange={
e=>
setTTY(
e.target.checked
)
}

/>


TTY


</label>





<label
className="checkbox"
>


<input

type="checkbox"

checked={privileged}

onChange={
e=>
setPrivileged(
e.target.checked
)
}

/>


Privileged


</label>







<h3>
Hardware Device
</h3>


{

devices.map(
(item,index)=>(


<div
className="config-row"
key={index}
>


<input

placeholder="/dev/dri:/dev/dri"

value={item}

onChange={
e=>{

let d=[
...devices
];

d[index]=
e.target.value;

setDevices(d);

}

}

/>


<button

onClick={()=>{


setDevices(
devices.filter(
(_,i)=>
i!==index
)
);


}}

>

-

</button>



</div>


)

)

}



<button

className="small-btn"

onClick={()=>


setDevices(
[
...devices,
""
]
)


}

>

+ Device

</button>






<div className="dialog-buttons">


<button

onClick={()=>
setCreate(false)
}

>

Cancel

</button>



<button

onClick={
createContainer
}

>

Create

</button>


</div>



</div>


</div>

}






);

};



export default Docker;
